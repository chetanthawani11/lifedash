rules_version = '2';

/**
 * LIFEDASH FIRESTORE SECURITY RULES
 *
 * These rules protect your data by ensuring:
 * 1. Users can only access their own data
 * 2. Data follows the expected structure
 * 3. Required fields are present
 * 4. No unauthorized access is possible
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user owns this data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if a field exists in the request data
    function hasField(field) {
      return field in request.resource.data;
    }

    // Check if data is a non-empty string
    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Check string length is within limit
    function isWithinLength(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Check if a number is positive
    function isPositiveNumber(value) {
      return value is number && value >= 0;
    }

    // Validate timestamp is not in the future (with 5 min buffer)
    function isValidTimestamp(value) {
      return value is timestamp && value <= request.time + duration.value(5, 'm');
    }

    // ============================================
    // USER DATA RULES
    // ============================================

    match /users/{userId} {
      // Users can read/write their own profile
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User preferences
      match /preferences/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Privacy settings
      match /privacy_settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // ============================================
      // FLASHCARDS
      // ============================================

      match /flashcard_folders/{folderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('name')
          && isNonEmptyString(request.resource.data.name)
          && isWithinLength(request.resource.data.name, 100);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /flashcard_decks/{deckId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('name')
          && isNonEmptyString(request.resource.data.name)
          && isWithinLength(request.resource.data.name, 200);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        // Nested flashcards
        match /flashcards/{cardId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Top-level flashcards
      match /flashcards/{cardId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('front')
          && hasField('back')
          && isNonEmptyString(request.resource.data.front)
          && isNonEmptyString(request.resource.data.back);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ============================================
      // JOURNALS
      // ============================================

      match /journals/{journalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('name')
          && isNonEmptyString(request.resource.data.name)
          && isWithinLength(request.resource.data.name, 100);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);

        // Nested entries
        match /entries/{entryId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Top-level journal entries
      match /journal_entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('journalId')
          && hasField('title')
          && hasField('content');
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ============================================
      // EXPENSES
      // ============================================

      match /expense_categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('name')
          && isNonEmptyString(request.resource.data.name)
          && isWithinLength(request.resource.data.name, 50);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('amount')
          && hasField('categoryId')
          && isPositiveNumber(request.resource.data.amount);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ============================================
      // NOTES
      // ============================================

      match /note_folders/{folderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('name')
          && isNonEmptyString(request.resource.data.name);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('title')
          && hasField('content');
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ============================================
      // TASKS
      // ============================================

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('title')
          && isNonEmptyString(request.resource.data.title)
          && isWithinLength(request.resource.data.title, 500);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /recurring_series/{seriesId} {
        allow read, write: if isOwner(userId);
      }

      // ============================================
      // DASHBOARD & GOALS
      // ============================================

      match /dashboard_settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasField('title')
          && isNonEmptyString(request.resource.data.title);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      match /goal_progress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================
    // DEFAULT: DENY ALL OTHER ACCESS
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
